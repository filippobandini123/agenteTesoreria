# Copiare in console.env (stessa cartella del compose) e compilare. Permessi ristretti, mai in git.
# Connessione con l'utente dedicato creato da permessi.sql (host visto dal container)
TESORERIA_PG_DSN=postgresql://tesoreria_console:<password>@<host>:5432/<database>
# Chiave delle sessioni: almeno 32 caratteri casuali, es. python -c "import secrets;print(secrets.token_urlsafe(48))"
CONSOLE_SECRET=<chiave casuale>
# Username del gestionale abilitati alla console (separati da virgola)
CONSOLE_UTENTI=<username cfo>,<username specialist>,<il tuo username>
# Facoltativo: valore di utente.stato che indica un utente attivo (vuoto = non controllato)
# CONSOLE_STATO_ATTIVO=1
# 1 se la console è servita in HTTPS (cookie "secure")
CONSOLE_HTTPS=0
# Durata della sessione in ore
CONSOLE_SESSIONE_ORE=8
